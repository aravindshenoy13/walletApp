<selector xmlns:android="http://schemas.android.com/apk/res/android">
<item android:state_enabled="false"><shape><solid android:color="@color/paper"/><stroke android:width="1dp" android:color="@color/line"/><padding android:left="8dp" android:right="8dp" android:top="8dp" android:bottom="8dp"/></shape></item>
<item android:state_checked="true" android:drawable="@drawable/selected_surface"/>
<item android:state_selected="true" android:drawable="@drawable/selected_surface"/>
<item android:state_focused="true" android:drawable="@drawable/selected_surface"/>
<item android:state_pressed="true" android:drawable="@drawable/selected_surface"/>
<item android:drawable="@drawable/action_outline"/>
</selector>