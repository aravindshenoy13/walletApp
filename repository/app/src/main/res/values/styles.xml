<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Wallet.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="radioButtonStyle">@style/SquareRadio</item>
        <item name="android:listChoiceIndicatorSingle">?android:attr/listChoiceIndicatorMultiple</item>
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryDark">@color/ink</item>
        <item name="colorAccent">@color/ink</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/quiet</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/legacy_navigation</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="SquareRadio" parent="Widget.AppCompat.CompoundButton.RadioButton"><item name="android:button">?android:attr/listChoiceIndicatorMultiple</item><item name="buttonCompat">@null</item></style>
    <style name="Theme.Wallet" parent="Theme.Wallet.Base" />
    <style name="FormLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/quiet</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="FormField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="PlainButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="OutlineButton" parent="PlainButton">
        <item name="android:background">@drawable/action_outline</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>
    <style name="SummaryLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/quiet</item>
    </style>
    <style name="SummaryValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textIsSelectable">true</item>
    </style>
</resources>
