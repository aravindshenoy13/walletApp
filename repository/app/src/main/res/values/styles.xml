<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Wallet.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="radioButtonStyle">@style/SquareRadio</item>
        <item name="checkboxStyle">@style/WireCheckbox</item>
        <item name="android:checkboxStyle">@style/WireCheckbox</item>
        <item name="spinnerStyle">@style/WireSpinner</item>
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryDark">@color/ink</item>
        <item name="colorAccent">@color/ink</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/quiet</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/legacy_navigation</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="SquareRadio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item><item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/selection_surface</item>
        <item name="android:gravity">center</item><item name="android:minHeight">48dp</item>
        <item name="android:padding">8dp</item>
    </style>
    <style name="WireCheckbox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@null</item><item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/selection_surface</item>
        <item name="android:minHeight">48dp</item><item name="android:padding">12dp</item>
    </style>
    <style name="WireSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/dropdown_background</item>
        <item name="android:paddingStart">8dp</item><item name="android:paddingEnd">32dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Theme.Wallet" parent="Theme.Wallet.Base" />
    <style name="ScreenHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="FormLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/quiet</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="FormField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="PlainButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingHorizontal">12dp</item>
    </style>
    <style name="OutlineButton" parent="PlainButton">
        <item name="android:background">@drawable/action_outline</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>
    <style name="SummaryLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/quiet</item>
    </style>
    <style name="SummaryValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textIsSelectable">true</item>
    </style>
</resources>
