<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout style="@style/ScreenHeader">
        <Button android:id="@+id/back" android:drawableStart="@drawable/ic_back" android:drawableTint="@color/icon_stroke" android:drawablePadding="4dp" style="@style/PlainButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" />
        <TextView style="@style/ScreenTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingHorizontal="8dp" android:text="@string/export_csv" android:textSize="20sp" android:textColor="@color/ink" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ink" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/FormLabel" android:layout_marginTop="0dp" android:text="Select accounts" />
            <LinearLayout android:layout_marginTop="8dp" android:id="@+id/account_choices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView style="@style/FormLabel" android:text="@string/export_label" />
            <RadioGroup android:layout_marginTop="8dp" android:id="@+id/export_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:checkedButton="@id/export_all" android:orientation="vertical">
                <RadioButton android:layout_marginBottom="4dp" android:gravity="start|center_vertical" android:padding="12dp" android:id="@+id/export_all" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/all_transactions" />
                <RadioButton android:layout_marginBottom="4dp" android:gravity="start|center_vertical" android:padding="12dp" android:id="@+id/export_income" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/income" />
                <RadioButton android:layout_marginBottom="4dp" android:gravity="start|center_vertical" android:padding="12dp" android:id="@+id/export_expenses" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/expenses" />
                <RadioButton android:layout_marginBottom="4dp" android:gravity="start|center_vertical" android:padding="12dp" android:id="@+id/export_transfers" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/transfers" />
            </RadioGroup>
            <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/error" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/retry" style="@style/OutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry" android:visibility="gone" />
            <Button android:background="@drawable/action_save" android:backgroundTint="@null" android:textColor="@color/action_save" android:drawableTint="@color/action_save" android:id="@+id/save" android:drawableStart="@drawable/ic_save"  android:drawablePadding="4dp" style="@style/OutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/choose_save"  android:gravity="start|center_vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:text="@string/export_help" android:textColor="@color/quiet" android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
