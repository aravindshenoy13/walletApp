<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="48dp" android:paddingHorizontal="16dp">
        <ImageButton android:id="@+id/settings" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_settings" app:tint="@color/ink" android:contentDescription="Settings" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="20sp" android:textStyle="bold" />
        <Button android:id="@+id/open_search" style="@style/PlainButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/search_records" android:drawableStart="@drawable/ic_search" android:drawableTint="@color/ink" />
        <LinearLayout android:id="@+id/search_box" android:layout_width="0dp" android:layout_weight="2" android:layout_height="48dp" android:layout_marginVertical="4dp" android:gravity="center_vertical" android:background="@drawable/search_background">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:src="@drawable/ic_search" app:tint="@color/ink" android:importantForAccessibility="no" />
            <com.aravind.wallet.ui.RecordsSearchField android:id="@+id/record_search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@android:color/transparent" android:paddingHorizontal="8dp" android:paddingVertical="0dp" android:hint="@string/search_records" android:inputType="text" android:singleLine="true" android:textSize="14sp" android:importantForAutofill="no" android:imeOptions="actionDone" />
            <Button android:id="@+id/clear_search" style="@style/PlainButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingHorizontal="8dp" android:text="@string/clear" android:textColor="@color/quiet" android:textSize="12sp" android:contentDescription="@string/clear_search" />
        </LinearLayout>
        <Button android:id="@+id/add" android:drawableStart="@drawable/ic_add" android:drawableTint="@color/icon_stroke" android:drawablePadding="4dp" style="@style/PlainButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_record" android:enabled="false" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ink" />
    <ProgressBar android:id="@+id/loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/loading" />
    <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textColor="@color/error" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <LinearLayout android:id="@+id/records_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/today_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:textColor="@color/quiet" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:orientation="vertical" android:focusableInTouchMode="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="3dp">
                <TextView style="@style/SummaryLabel" android:text="@string/income" android:textColor="@color/income_amount" />
                <TextView android:id="@+id/income" style="@style/SummaryValue" android:textColor="@color/income_amount" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="3dp">
                <TextView style="@style/SummaryLabel" android:text="@string/expenses" android:textColor="@color/expense_amount" />
                <TextView android:id="@+id/expense" style="@style/SummaryValue" android:textColor="@color/expense_amount" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="3dp">
                <TextView style="@style/SummaryLabel" android:text="@string/net" />
                <TextView android:id="@+id/net" style="@style/SummaryValue" android:textStyle="bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/line" />
            <TextView android:id="@+id/record_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="@string/all_records" android:textSize="14sp" android:textColor="@color/quiet" />
            <TextView android:id="@+id/empty_records" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:textSize="16sp" android:visibility="gone" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/record_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="16dp" android:paddingBottom="16dp" />
        <Button android:id="@+id/add_record_button" android:drawableStart="@drawable/ic_add" android:drawableTint="@color/icon_stroke" android:drawablePadding="4dp" style="@style/OutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:text="@string/add_record" android:enabled="false" />
        <Button android:id="@+id/export" style="@style/PlainButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/export_csv" android:enabled="false" />
    </LinearLayout>
    <include android:id="@+id/analysis_panel" layout="@layout/panel_analysis" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
    <LinearLayout android:id="@+id/accounts_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/total_balance" android:textSize="14sp" android:textColor="@color/quiet" />
        <TextView android:id="@+id/total_balance" android:textStyle="bold" android:textColor="@color/ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:paddingVertical="8dp" android:textIsSelectable="true" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
        <TextView android:id="@+id/empty_accounts" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:text="@string/no_accounts" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="@string/history_hint" android:textColor="@color/quiet" android:textSize="12sp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/account_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/categories_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/category_help" android:textColor="@color/quiet" android:textSize="14sp" android:paddingBottom="12dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/category_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ink" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/records_tab" android:drawableTop="@drawable/ic_receipt" android:drawableTint="@color/icon_stroke" android:drawablePadding="4dp" style="@style/PlainButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/records" android:textSize="12sp" />
        <Button android:id="@+id/analysis_tab" android:drawableTop="@drawable/ic_chart" android:drawableTint="@color/icon_stroke" android:drawablePadding="4dp" style="@style/PlainButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/analysis" android:textSize="12sp" />
        <Button android:id="@+id/accounts_tab" android:drawableTop="@drawable/ic_account" android:drawableTint="@color/icon_stroke" android:drawablePadding="4dp" style="@style/PlainButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/accounts" android:textSize="12sp" />
        <Button android:id="@+id/categories_tab" android:drawableTop="@drawable/ic_category_tag" android:drawableTint="@color/icon_stroke" android:drawablePadding="4dp" style="@style/PlainButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/categories" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
