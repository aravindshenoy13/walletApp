<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout style="@style/ScreenHeader">
        <Button android:id="@+id/back" android:drawableStart="@drawable/ic_back" android:drawableTint="@color/icon_stroke" android:drawablePadding="4dp" style="@style/PlainButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingHorizontal="8dp" android:text="@string/new_account" android:textSize="20sp" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ink" />
    <ProgressBar android:id="@+id/loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/loading" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <TextView style="@style/FormLabel" android:text="@string/account_name" android:labelFor="@id/name" />
            <EditText android:id="@+id/name" style="@style/FormField" android:inputType="textCapWords" android:maxLength="80" android:maxLines="1" android:imeOptions="actionNext" android:importantForAutofill="no" />
            <TextView style="@style/FormLabel" android:text="Account icon" />
            <RadioGroup android:id="@+id/account_icon" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/icon_bank"><RadioButton android:id="@+id/icon_bank" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:drawableTop="@drawable/ic_bank" android:drawableTint="@color/icon_stroke" android:text="Bank" /><RadioButton android:id="@+id/icon_cash" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:drawableTop="@drawable/ic_cash" android:drawableTint="@color/icon_stroke" android:text="Cash" /><RadioButton android:id="@+id/icon_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:drawableTop="@drawable/ic_card" android:drawableTint="@color/icon_stroke" android:text="Card" /></RadioGroup>
            <TextView style="@style/FormLabel" android:text="@string/opening_balance" android:labelFor="@id/opening_balance" />
            <EditText android:id="@+id/opening_balance" style="@style/FormField" android:inputType="numberDecimal|numberSigned" android:digits="0123456789.-" android:maxLength="22" android:maxLines="1" android:importantForAutofill="no" />
            <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/error" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/save" android:drawableStart="@drawable/ic_save" android:drawableTint="@color/icon_stroke" android:drawablePadding="4dp" style="@style/OutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_account" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
