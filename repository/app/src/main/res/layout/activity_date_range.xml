<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout style="@style/ScreenHeader">
        <Button android:id="@+id/back" android:drawableStart="@drawable/ic_back" android:drawableTint="@color/icon_stroke" android:drawablePadding="4dp" style="@style/PlainButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingHorizontal="8dp" android:text="@string/custom_range" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ink" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/FormLabel" android:text="@string/range_from" android:labelFor="@id/start_date" />
            <Button android:id="@+id/start_date" style="@style/PlainButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:paddingHorizontal="8dp" android:gravity="start|center_vertical" android:textSize="16sp" android:textColor="@color/ink" android:background="@drawable/date_field_background" android:backgroundTint="@null" app:backgroundTint="@null" />
            <TextView style="@style/FormLabel" android:layout_marginTop="16dp" android:text="@string/range_to" android:labelFor="@id/end_date" />
            <Button android:id="@+id/end_date" style="@style/PlainButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:paddingHorizontal="8dp" android:gravity="start|center_vertical" android:textSize="16sp" android:textColor="@color/ink" android:background="@drawable/date_field_background" android:backgroundTint="@null" app:backgroundTint="@null" />
            <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/invalid_range" android:textColor="@color/error" android:visibility="gone" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/apply" style="@style/PlainButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/action_outline" android:backgroundTint="@null" app:backgroundTint="@null" android:textColor="@color/ink" android:text="@string/apply_range" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/range_help" android:textSize="12sp" android:textColor="@color/quiet" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
